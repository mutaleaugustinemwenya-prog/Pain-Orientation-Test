# Copy this file to .env and fill in real values. .env is gitignored; this file is not.

DATABASE_URL="postgresql://utushimi:utushimi_dev@localhost:5432/utushimi_dev?schema=public"

# Symmetric secret used to sign session JWTs. Generate a real 32+ byte secret in production,
# e.g. `openssl rand -hex 32`.
AUTH_SECRET="replace-with-a-real-32-byte-secret"

# Which PaymentProvider implementation to use: "mock" | "moneyunify" | "lipila" | "dpo" | "nsano"
PAYMENT_PROVIDER="mock"

# Platform's share of each story sale, as a decimal (0.30 = platform keeps 30%, writer gets 70%)
PLATFORM_REVENUE_SHARE="0.30"

# Minimum payout balance (in ngwee, i.e. 1/100 of a Kwacha) before a writer is eligible for payout
MIN_PAYOUT_THRESHOLD_NGWEE="5000000"

# Days after purchase before a sale is eligible for payout (refund/holdback window)
PAYOUT_HOLDBACK_DAYS="7"

# --- MTN MoMo / Airtel Money sandbox credentials ---
# These are NOT used by the mock provider to make real network calls — collect()/disburse()
# stay fully synthetic so the app works with zero live credentials. MockPaymentProvider reads
# and logs them (see src/lib/payments/mock-provider.ts) purely so the credential shape already
# exists here for whichever real integration replaces the mock later (a direct MTN/Airtel
# sandbox adapter, or one of the aggregator adapters in src/lib/payments/adapters/).
#
# MTN MoMo Developer Sandbox (register at https://momodeveloper.mtn.com):
MTN_MOMO_SANDBOX_SUBSCRIPTION_KEY=""
MTN_MOMO_SANDBOX_API_USER=""
MTN_MOMO_SANDBOX_API_KEY=""
MTN_MOMO_SANDBOX_TARGET_ENVIRONMENT="sandbox"

# Airtel Money Developer Sandbox (register at https://developers.airtel.africa):
AIRTEL_SANDBOX_CLIENT_ID=""
AIRTEL_SANDBOX_CLIENT_SECRET=""
